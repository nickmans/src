[Unit]
Description=OMNI ROS2 Stack
After=network.target systemd-udev-settle.service
Wants=systemd-udev-settle.service
Conflicts=omni_udp_server.service

[Service]
Type=simple
User=nickolas
WorkingDirectory=/home/nickolas/ros2_ws/src/omni_src/pi_comm_server
Environment="PYTHONUNBUFFERED=1"
Environment="ROS_DOMAIN_ID=0"
ExecStartPre=-/usr/bin/pkill -f "ros2 launch omni_traj dual_sllidar_with_mock_and_traj.launch.py"
ExecStartPre=-/usr/bin/pkill -f "/home/nickolas/ros2_ws/install/omni_traj/lib/omni_traj/waypoint_traj"
ExecStartPre=-/usr/bin/pkill -f "/home/nickolas/ros2_ws/install/sllidar_ros2/lib/sllidar_ros2/sllidar_node"
ExecStart=/bin/bash /home/nickolas/ros2_ws/src/omni_src/pi_comm_server/start_ros2_stack.sh
KillSignal=SIGINT
TimeoutStartSec=90
TimeoutStopSec=10
Restart=on-failure
RestartSec=2
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
