[Unit]
Description=OMNI UDP Communication Server with ROS2 Support
After=network.target
Conflicts=omni_ros2_stack.service omni_lidar_wakeup.service

[Service]
Type=simple
User=nickolas
WorkingDirectory=/home/nickolas/ros2_ws/src/omni_src/pi_comm_server
Environment="PYTHONUNBUFFERED=1"
Environment="ROS_DOMAIN_ID=0"
ExecStart=/bin/bash -c 'source /opt/ros/jazzy/setup.bash && source /home/nickolas/ros2_ws/install/setup.bash && exec python3 /home/nickolas/ros2_ws/src/omni_src/pi_comm_server/run_udp_server.py'
KillSignal=SIGINT
TimeoutStartSec=10
TimeoutStopSec=5
Restart=on-failure
RestartSec=2
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
