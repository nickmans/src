[Unit]
Description=OMNI Communication Server with ROS2 Support
After=network.target

[Service]
Type=simple
User=nickolas
WorkingDirectory=/home/nickolas/ros2_ws/src/omni_src/pi_comm_server
Environment="PYTHONUNBUFFERED=1"
Environment="ROS_DOMAIN_ID=0"
ExecStart=/usr/bin/python3 /home/nickolas/ros2_ws/src/omni_src/pi_comm_server/run_server.py --enable-ros2-cmds
KillSignal=SIGINT
TimeoutStartSec=10
TimeoutStopSec=5
Restart=on-failure
RestartSec=2
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
