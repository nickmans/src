HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO
TRANSPORT=ethernet

UPDATE_HZ=20
DEADZONE=0.08
MAX_SPEED=100
INPUT_TIMEOUT_S=0.35

# Ethernet transport target (STM32)
ETH_TARGET_IP=192.168.1.10
ETH_TARGET_PORT=9001

# Bluetooth serial endpoint (RFCOMM or direct tty)
BT_DEVICE=/dev/rfcomm0
BT_BAUDRATE=115200
BT_RECONNECT_INTERVAL_S=2.0

# Command strings sent to STM32
CMD_JOY=joy
CMD_FOCUS=focus
CMD_FACE_FORWARD=face

# Two-line mode templates
CMD_DIR_TEMPLATE=dir {angle}
CMD_SPEED_TEMPLATE=speed {speed}

# Single-line mode (recommended for lower serial overhead)
CMD_USE_SINGLE_LINE=true
CMD_SINGLE_LINE_TEMPLATE=dir {angle} speed {speed}
CMD_SINGLE_LINE_TEMPLATE=dir {angle} speed {speed}